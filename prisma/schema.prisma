// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────── USER & AUTH ───────────────────────────

model User {
  id                  String    @id @default(uuid())
  email               String    @unique
  password            String
  fullName            String
  accountType         AccountType
  agncyId             String    @unique
  emailVerified       Boolean   @default(false)
  resetToken          String?
  resetTokenExpires   DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  deletedAt           DateTime?

  // Payment Provider Infrastructure Identifiers
  providerLegalEntityId     String?
  providerCounterpartyId    String?
  providerAccountId         String?
  providerLedgerAccountId   String?
  kybStatus                 KybStatus @default(not_started)

  // Relations
  workspacesOwned Workspace[]
  memberships     Membership[]
  wallet          Wallet?
  invoicesCreated Invoice[]     @relation("InvoiceCreator")
  invoicesAsBrand Invoice[]     @relation("InvoiceBrand")
  transactions    Transaction[]
  treasury        BrandTreasury?
  businessProfile BusinessProfile?
  representative  Representative?
  authorization   Authorization?
  brandVerification BrandVerification?
  bankDetails     BankDetails?
  documents       Document[]
  integrations    IntegrationConnection[]
  quickBooksConnection QuickBooksConnection?
  quickBooksInvoices   QuickBooksInvoice[]
  refreshTokens   RefreshToken[]
  agencyExternalAccounts AgencyExternalAccount[]
  payouts         Payout[]

  // Cybrid relations
  cybridCustomer     CybridCustomer?
  talentsManaged     Talent[]         @relation("AgencyTalents")
  paymentsAsBrand    Payment[]        @relation("PaymentBrand")
  paymentsAsAgency   Payment[]        @relation("PaymentAgency")
  paymentPayouts     PaymentPayout[]  @relation("PayoutAgency")

  @@map("users")

}

// ─────────────────────────── WALLET & LEDGER ───────────────────────────

model Wallet {
  id          String        @id @default(uuid())
  walletId    String        @unique // Primary identity e.g. WAL-AGY-849201
  userId      String        @unique
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountType AccountType
  balance     Float         @default(0.0)
  currency    String        @default("USD")
  status      WalletStatus  @default(active)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deletedAt   DateTime?

  ledgerEntries WalletLedger[]
  invoicesAsAgency Invoice[]   @relation("AgencyWalletInvoices")
  invoicesAsBrand  Invoice[]   @relation("BrandWalletInvoices")

  @@map("wallets")
}

enum WalletStatus {
  active
  frozen
  suspended
}

model WalletLedger {
  id            String     @id @default(uuid())
  walletId      String
  wallet        Wallet     @relation(fields: [walletId], references: [id], onDelete: Cascade)
  type          LedgerType
  amount        Float
  balanceAfter  Float
  referenceType String     // INVOICE_PAYMENT, DEPOSIT, DISBURSEMENT
  referenceId   String?
  description   String     @default("")
  createdAt     DateTime   @default(now())

  @@map("wallet_ledgers")
}

enum LedgerType {
  credit
  debit
}


model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("refresh_tokens")
}

enum AccountType {
  brand
  agency
}

// ─────────────────────────── WORKSPACE ───────────────────────────

model Workspace {
  id                 String             @id @default(uuid())
  type               WorkspaceType
  name               String
  agncyId            String             @unique
  verificationTrack  VerificationTrack  @default(kyb)
  verificationStatus VerificationStatus @default(draft)
  ownerId            String
  owner              User               @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  deletedAt          DateTime?

  memberships Membership[]

  @@map("workspaces")
}

model Membership {
  id          String          @id @default(uuid())
  userId      String
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceId String
  workspace   Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  role        WorkspaceRole
  permissions String[]
  status      MembershipStatus @default(active)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  deletedAt   DateTime?

  @@unique([userId, workspaceId])
  @@map("memberships")
}

enum WorkspaceType {
  brand
  agency
  mother_agency
}

enum VerificationTrack {
  kyb
  enterprise_kyb
}

enum VerificationStatus {
  draft
  submitted
  in_review
  requires_action
  approved
  rejected
  suspended
}

enum WorkspaceRole {
  admin
  finance
  approver
  viewer
  agency_admin
  finance_manager
  super_admin
  treasury
  finance_ops
}

enum MembershipStatus {
  active
  invited
  requested
}

// ─────────────────────────── BUSINESS VERIFICATION ───────────────────────────

model BusinessProfile {
  id                 String    @id @default(uuid())
  userId             String    @unique
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  legalName          String    @default("")
  brandName          String    @default("")
  businessType       String    @default("")
  country            String    @default("")
  registrationNumber String    @default("")
  taxId              String?
  website            String    @default("")
  email              String    @default("")
  phone              String?
  industry           String    @default("")
  address            String    @default("")
  addressLine1       String    @default("")
  addressLine2       String    @default("")
  city               String    @default("")
  businessState      String    @default("")
  stateOrProvince    String    @default("")
  zipCode            String    @default("")
  postalCode         String    @default("")
  companyDescription String    @default("")
  firstName          String    @default("")
  lastName           String    @default("")
  dob                String    @default("")
  ssnLast4           String    @default("")
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?

  @@map("business_profiles")
}

model Representative {
  id              String               @id @default(uuid())
  userId          String               @unique
  user            User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName        String               @default("")
  jobTitle        String               @default("")
  dob             String               @default("")
  nationality     String               @default("")
  email           String               @default("")
  phone           String               @default("")
  address         String               @default("")
  idType          String               @default("Passport")
  idFrontUploaded Boolean              @default(false)
  idBackUploaded  Boolean              @default(false)
  selfieUploaded  Boolean              @default(false)
  status          RepresentativeStatus @default(not_started)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  deletedAt       DateTime?

  @@map("representatives")
}

enum RepresentativeStatus {
  not_started
  uploaded
  processing
  verified
  rejected
}

model Authorization {
  id                      String    @id @default(uuid())
  userId                  String    @unique
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  isOwner                 Boolean?
  owns25Percent           Boolean?
  isAuthorizedForPayments Boolean?
  authLetterUploaded      Boolean   @default(false)
  powerOfAttorneyUploaded Boolean   @default(false)
  signatoryName           String    @default("")
  signatoryEmail          String    @default("")
  roleInCompany           String    @default("")
  formationDate           String    @default("")
  incorporationState      String    @default("")
  employeeRange           String    @default("")
  monthlyPaymentVolume    String    @default("")
  owners                  Json      @default("[]")
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  deletedAt               DateTime?

  @@map("authorizations")
}

model BrandVerification {
  id                          String             @id @default(uuid())
  userId                      String             @unique
  user                        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  brandName                   String             @default("")
  officialWebsite             String             @default("")
  officialEmail               String             @default("")
  domainVerified              Boolean            @default(false)
  trademarkNumber             String             @default("")
  brandCategory               String             @default("")
  logoUploaded                Boolean            @default(false)
  brandProofUploaded          Boolean            @default(false)
  trademarkCertUploaded       Boolean            @default(false)
  distributorContractUploaded Boolean            @default(false)
  authLetterUploaded          Boolean            @default(false)
  domainVerificationCode      String             @default("123456")
  domainCodeSent              Boolean            @default(false)
  domainCodeAttempts          Int                @default(0)
  emailDomainWarning          Boolean            @default(false)
  status                      VerificationStatus @default(draft)
  createdAt                   DateTime           @default(now())
  updatedAt                   DateTime           @updatedAt
  deletedAt                   DateTime?

  @@map("brand_verifications")
}

model BankDetails {
  id                String           @id @default(uuid())
  userId            String           @unique
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountHolderName String           @default("")
  bankName          String           @default("")
  country           String           @default("")
  currency          String           @default("USD")
  accountNumber     String           @default("")
  routingNumber     String           @default("")
  bankAddress       String           @default("")
  statementUploaded Boolean          @default(false)
  holderNameWarning Boolean          @default(false)
  plaidAccessToken  String?
  plaidAccountId    String?
  plaidItemId       String?
  status            BankDetailStatus @default(not_started)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  deletedAt         DateTime?

  @@map("bank_details")
}

enum BankDetailStatus {
  not_started
  uploaded
  processing
  approved
  rejected
}

model Document {
  id         String         @id @default(uuid())
  userId     String
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  label      String
  type       String
  status     DocumentStatus @default(not_uploaded)
  fileUrl    String?
  uploadedAt DateTime?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  deletedAt  DateTime?

  @@map("documents")
}

enum DocumentStatus {
  not_uploaded
  uploaded
  approved
  rejected
}

// ─────────────────────────── INVOICES & TRANSACTIONS ───────────────────────────

model Invoice {
  id             String        @id @default(uuid())
  invoiceNumber  String        @unique
  campaign       String        @default("")
  agencyId       String
  agency         User          @relation("InvoiceCreator", fields: [agencyId], references: [id])
  agencyEmail    String
  agencyWalletId String?
  agencyWallet   Wallet?       @relation("AgencyWalletInvoices", fields: [agencyWalletId], references: [id])
  brandId        String
  brand          User          @relation("InvoiceBrand", fields: [brandId], references: [id])
  brandName      String
  brandEmail     String
  brandWalletId  String?
  brandWallet    Wallet?       @relation("BrandWalletInvoices", fields: [brandWalletId], references: [id])
  amount         Float
  due            String
  status         InvoiceStatus @default(pending)
  payoutStatus   PayoutStatus  @default(pending)
  createdDate    String

  payerId       String        @default("")
  payerEmail    String        @default("")
  payerAddress  String[]      @default([])
  splits        Json          @default("[]")
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  deletedAt     DateTime?

  transactions Transaction[]

  @@map("invoices")
}

enum InvoiceStatus {
  pending
  processing
  paid
  overdue
}

enum KybStatus {
  not_started
  pending
  approved
  rejected
}

enum PayoutStatus {
  pending
  processing
  disbursed
  failed
  returned
}

model AgencyExternalAccount {
  id                               String   @id @default(uuid())
  agencyId                         String
  agency                           User     @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  accountName                      String   @default("")
  bankName                         String   @default("")
  accountNumberMask                String   @default("")
  routingNumber                    String   @default("")
  providerExternalAccountId String   @unique
  isPrimary                        Boolean  @default(false)
  createdAt                        DateTime @default(now())
  updatedAt                        DateTime @updatedAt

  @@map("agency_external_accounts")
}

model Payout {
  id                           String       @id @default(uuid())
  agencyId                     String
  agency                       User         @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  amount                       Float
  currency                     String       @default("USD")
  destinationExternalAccountId String
  paymentOrderId               String?      @unique
  status                       PayoutStatus @default(pending)
  metadata                     Json         @default("{}")
  createdAt                    DateTime     @default(now())
  updatedAt                    DateTime     @updatedAt

  @@map("payouts")
}

model WebhookEvent {
  id          String   @id @default(uuid())
  eventId     String   @unique
  eventType   String
  status      String   @default("processed")
  payload     Json     @default("{}")
  processedAt DateTime @default(now())

  @@map("webhook_events")
}

model Transaction {
  id             String            @id @default(uuid())
  invoiceId      String
  invoice        Invoice           @relation(fields: [invoiceId], references: [id])
  userId         String
  user           User              @relation(fields: [userId], references: [id])
  amount         Float
  currency       String            @default("USD")
  timestamp      DateTime          @default(now())
  paymentMethod  String            @default("")
  paymentOrderId String?
  counterpartyId String?
  status         TransactionStatus @default(processing)
  createdAt      DateTime          @default(now())
  deletedAt      DateTime?

  @@map("transactions")
}

enum TransactionStatus {
  success
  failed
  processing
}

// ─────────────────────────── TREASURY ───────────────────────────

model BrandTreasury {
  id                String    @id @default(uuid())
  userId            String    @unique
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance           Float     @default(25000)
  lastDepositAmount Float?
  lastDepositMethod String?
  lastUpdated       DateTime  @default(now())
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  @@map("brand_treasuries")
}

// ─────────────────────────── INTEGRATIONS ───────────────────────────

model IntegrationConnection {
  id              String              @id @default(uuid())
  userId          String
  user            User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider        IntegrationProvider
  accessToken     String              @default("")
  refreshToken    String              @default("")
  realmId         String?
  tenantId        String?
  itemId          String?
  institutionName String?
  expiresAt       DateTime?
  status          IntegrationStatus   @default(disconnected)
  connectedAt     DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  deletedAt       DateTime?

  @@unique([userId, provider])
  @@map("integration_connections")
}

enum IntegrationProvider {
  quickbooks
  xero
  plaid
  sage
}

enum IntegrationStatus {
  connected
  disconnected
  expired
}

// ─────────────────────────── AUDIT LOGS & FEATURE FLAGS ───────────────────────────

model AuditLog {
  id          String   @id @default(uuid())
  userId      String?
  workspaceId String?
  action      String
  entityType  String
  entityId    String?
  details     Json     @default("{}")
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  @@map("audit_logs")
}

model FeatureFlag {
  id          String   @id @default(uuid())
  key         String   @unique
  enabled     Boolean  @default(true)
  description String   @default("")
  rules       Json     @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("feature_flags")
}

// ─────────────────────────── QUICKBOOKS MODULE ───────────────────────────

model QuickBooksConnection {
  id           String                  @id @default(uuid())
  agencyId     String                  @unique
  agency       User                    @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  realmId      String?
  accessToken  String                  @default("")
  refreshToken String                  @default("")
  tokenExpiry  DateTime?
  status       QuickBooksConnectStatus @default(disconnected)
  connectedAt  DateTime?
  lastSync     DateTime?
  lastError    String?
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt

  @@map("quickbooks_connections")
}

enum QuickBooksConnectStatus {
  disconnected
  connecting
  connected
  syncing
  expired
  reconnect_required
  sync_failed
}

model QuickBooksInvoice {
  id                  String   @id @default(uuid())
  agencyId            String
  agency              User     @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  quickbooksInvoiceId String
  invoiceNumber       String
  customerName        String
  amount              Float
  currency            String   @default("USD")
  issueDate           String
  dueDate             String
  status              String
  syncedAt            DateTime @default(now())
  rawPayload          Json     @default("{}")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([agencyId, quickbooksInvoiceId])
  @@map("quickbooks_invoices")
}

// ─────────────────────────── CYBRID INTEGRATION ───────────────────────────

model CybridCustomer {
  id                    String    @id @default(uuid())
  userId                String    @unique
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  cybridCustomerGuid    String    @unique
  customerType          String    @default("business")
  kybStatus             String    @default("not_started")
  kybVerificationGuid   String?
  kybOutcome            String?
  cybridBankGuid        String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  accounts              CybridAccount[]
  counterparties        CybridCounterparty[]

  @@map("cybrid_customers")
}

model CybridAccount {
  id                    String    @id @default(uuid())
  cybridCustomerId      String
  cybridCustomer        CybridCustomer @relation(fields: [cybridCustomerId], references: [id], onDelete: Cascade)
  cybridAccountGuid     String    @unique
  accountType           String    // 'fiat', 'trading'
  asset                 String    // 'USD', 'USDC'
  name                  String?
  status                String    @default("created")
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  depositBankAccounts   CybridDepositBankAccount[]

  @@map("cybrid_accounts")
}

model CybridDepositBankAccount {
  id                       String    @id @default(uuid())
  cybridAccountId          String
  cybridAccount            CybridAccount @relation(fields: [cybridAccountId], references: [id], onDelete: Cascade)
  cybridDepositBankGuid    String    @unique
  uniqueMemoId             String?
  routingNumberType        String?
  routingNumber            String?
  accountNumber            String?
  bankName                 String?
  label                    String?
  depositType              String?
  status                   String    @default("created")
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  @@map("cybrid_deposit_bank_accounts")
}

model CybridCounterparty {
  id                       String    @id @default(uuid())
  cybridCustomerId         String
  cybridCustomer           CybridCustomer @relation(fields: [cybridCustomerId], references: [id], onDelete: Cascade)
  cybridCounterpartyGuid   String    @unique
  name                     String
  counterpartyType         String    @default("individual")
  talentId                 String?
  talent                   Talent?   @relation(fields: [talentId], references: [id])
  status                   String    @default("storing")
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  externalBankAccounts     CybridExternalBankAccount[]

  @@map("cybrid_counterparties")
}

model CybridExternalBankAccount {
  id                          String    @id @default(uuid())
  cybridCounterpartyId        String?
  cybridCounterparty          CybridCounterparty? @relation(fields: [cybridCounterpartyId], references: [id])
  cybridExternalBankGuid      String    @unique
  customerGuid                String?
  asset                       String    @default("USD")
  accountKind                 String?   // 'plaid', 'plaid_processor_token', 'raw_routing_details'
  bankName                    String?
  mask                        String?
  plaidInstitutionId          String?
  status                      String    @default("storing")
  failureCode                 String?
  // For agency own external accounts
  agencyUserId                String?
  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt

  @@map("cybrid_external_bank_accounts")
}

// ─────────────────────────── TALENT ───────────────────────────

model Talent {
  id              String    @id @default(uuid())
  agencyId        String
  agency          User      @relation("AgencyTalents", fields: [agencyId], references: [id], onDelete: Cascade)
  fullName        String
  email           String?
  phone           String?
  country         String    @default("US")
  isInternational Boolean   @default(false)
  status          String    @default("active")
  metadata        Json      @default("{}")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  counterparties  CybridCounterparty[]
  paymentPayouts  PaymentPayout[]

  @@map("talents")
}

// ─────────────────────────── PAYMENT (Brand → Agency) ───────────────────────────

model Payment {
  id                  String    @id @default(uuid())
  paymentNumber       String    @unique
  brandId             String
  brand               User      @relation("PaymentBrand", fields: [brandId], references: [id])
  agencyId            String
  agency              User      @relation("PaymentAgency", fields: [agencyId], references: [id])
  invoiceId           String?
  amount              Float
  currency            String    @default("USD")
  status              String    @default("CREATED")
  paymentMethod       String    @default("ach")

  // Cybrid references
  cybridTransferGuid  String?
  cybridDepositRef    String?

  fundedAt            DateTime?
  completedAt         DateTime?
  failedAt            DateTime?
  failureReason       String?
  failureStage        String?

  metadata            Json      @default("{}")
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  payouts             PaymentPayout[]
  providerOperations  ProviderOperation[] @relation("PaymentOperations")

  @@map("payments")
}

// ─────────────────────────── PAYOUT (Agency → Talent / External) ───────────────────────────

model PaymentPayout {
  id                     String    @id @default(uuid())
  payoutNumber           String    @unique
  paymentId              String?
  payment                Payment?  @relation(fields: [paymentId], references: [id])
  agencyId               String
  agency                 User      @relation("PayoutAgency", fields: [agencyId], references: [id])
  talentId               String?
  talent                 Talent?   @relation(fields: [talentId], references: [id])
  amount                 Float
  currency               String    @default("USD")
  payoutType             String    @default("domestic")   // domestic, international, agency_withdrawal
  status                 String    @default("CREATED")

  // Cybrid references
  cybridQuoteGuid        String?
  cybridTransferGuid     String?
  cybridTradeGuid        String?
  cybridPlanGuid         String?
  cybridExecutionGuid    String?
  destinationAccountGuid String?

  // Failure tracking
  failedAt               DateTime?
  failureReason          String?
  failureStage           String?

  // FX info (international)
  fxRate                 Float?
  fxFee                  Float?
  destinationAmount      Float?
  destinationCurrency    String?

  completedAt            DateTime?
  metadata               Json      @default("{}")
  idempotencyKey         String?   @unique
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  providerOperations     ProviderOperation[] @relation("PayoutOperations")

  @@map("payment_payouts")
}

// ─────────────────────────── PROVIDER OPERATIONS ───────────────────────────

model ProviderOperation {
  id                  String    @id @default(uuid())
  provider            String    @default("cybrid")
  operationType       String    // 'transfer', 'trade', 'quote', 'plan', 'execution', 'kyb_verification'
  operationGuid       String
  paymentId           String?
  payment             Payment?  @relation("PaymentOperations", fields: [paymentId], references: [id])
  payoutId            String?
  payout              PaymentPayout? @relation("PayoutOperations", fields: [payoutId], references: [id])
  status              String
  rawResponse         Json      @default("{}")
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@unique([provider, operationType, operationGuid])
  @@map("provider_operations")
}

// ─────────────────────────── DOUBLE-ENTRY LEDGER ───────────────────────────

model LedgerAccount {
  id                  String    @id @default(uuid())
  accountCode         String    @unique   // e.g. 'AGENCY:userId:USD', 'BRAND:userId:RECEIVABLE'
  accountType         String              // asset, liability, equity, revenue, expense
  name                String
  currency            String    @default("USD")
  ownerId             String?             // userId
  ownerType           String?             // brand, agency, system
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@map("ledger_accounts")
}

model JournalEntry {
  id                  String    @id @default(uuid())
  debitAccountId      String
  creditAccountId     String
  amount              Float
  currency            String    @default("USD")
  status              String    @default("posted")  // posted, pending, reversed
  referenceType       String    // PAYMENT, PAYOUT, FEE, TRADE, REFUND
  referenceId         String?
  providerReference   String?
  description         String    @default("")
  postedAt            DateTime  @default(now())
  createdAt           DateTime  @default(now())

  // Immutable — no updatedAt
  @@map("journal_entries")
}

// ─────────────────────────── RECONCILIATION ───────────────────────────

model ReconciliationRecord {
  id                  String    @id @default(uuid())
  reconciliationType  String    // 'balance', 'transfer', 'trade'
  entityType          String    // 'payment', 'payout'
  entityId            String?
  cybridState         String?
  internalState       String?
  cybridAmount        Float?
  internalAmount      Float?
  discrepancyType     String?   // 'status_mismatch', 'amount_mismatch', 'missing_internal', 'missing_cybrid'
  resolution          String?   @default("unresolved")
  resolvedAt          DateTime?
  resolvedBy          String?
  notes               String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@map("reconciliation_records")
}

