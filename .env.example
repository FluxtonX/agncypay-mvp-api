# AgncyPay API — Environment Variables
# Copy this file to .env and fill in all required values

# ─── Database ─────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/agncypay?schema=public"

# ─── Authentication ───────────────────────────────────────────
JWT_SECRET="agncypay-jwt-secret-change-in-production"
JWT_REFRESH_SECRET="agncypay-jwt-refresh-secret-change-in-production"
JWT_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"

# Development/test capture provider only. Required to read captured auth
# emails from GET /api/v1/auth/development/emails/:deliveryId.
AUTH_EMAIL_MODE=capture
AUTH_EMAIL_CAPTURE_KEY=replace-with-a-long-random-development-key

# Staging/production email delivery. The ECS task role supplies AWS
# credentials; never configure static AWS access keys in the application.
AWS_REGION=us-east-1
AUTH_EMAIL_FROM="AgncyPay <no-reply@agncy.xyz>"
AUTH_EMAIL_REPLY_TO=

# Optional one-time platform bootstrap used by `npm run db:seed`.
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=
PLATFORM_ADMIN_NAME="AgncyPay Platform Admin"

# ─── Conduit (Financial Infrastructure) ───────────────────────
CONDUIT_API_KEY=your-conduit-api-key
CONDUIT_API_SECRET=your-conduit-api-secret
CONDUIT_BASE_URL=https://sandbox-api.conduit.financial
CONDUIT_ENVIRONMENT=sandbox
CONDUIT_API_VERSION=2024-12-01
CONDUIT_WEBHOOK_SECRET=your-conduit-webhook-secret

# ─── Plaid (Bank Verification) ───────────────────────────────
PLAID_CLIENT_ID=your-plaid-client-id
PLAID_SECRET=your-plaid-secret
PLAID_ENV=sandbox

# ─── QuickBooks ───────────────────────────────────────────────
QUICKBOOKS_CLIENT_ID=your-quickbooks-client-id
QUICKBOOKS_CLIENT_SECRET=your-quickbooks-client-secret
QUICKBOOKS_ENVIRONMENT=sandbox
QUICKBOOKS_REDIRECT_URI=http://localhost:3001/api/v1/integrations/quickbooks/callback

# ─── QBO Aliases ─────────────────────────────────────────────
QBO_CLIENT_ID=your-quickbooks-client-id
QBO_CLIENT_SECRET=your-quickbooks-client-secret
QBO_ENV=sandbox
QBO_REDIRECT_URI=http://localhost:3001/api/v1/integrations/quickbooks/callback

# ─── Xero ────────────────────────────────────────────────────
XERO_CLIENT_ID=your-xero-client-id
XERO_CLIENT_SECRET=your-xero-client-secret
XERO_REDIRECT_URI=http://localhost:3001/api/v1/integrations/xero/callback

# ─── Sage ────────────────────────────────────────────────────
SAGE_CLIENT_ID=
SAGE_CLIENT_SECRET=
SAGE_REDIRECT_URI=http://localhost:3001/api/v1/integrations/sage/callback

# ─── Frontend ────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
