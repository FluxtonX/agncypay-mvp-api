# AgncyPay API — Environment Variables
# Copy this file to .env and fill in all required values

# ─── Database ─────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/agncypay?schema=public"

# ─── Authentication ───────────────────────────────────────────
JWT_SECRET="agncypay-jwt-secret-change-in-production"
JWT_REFRESH_SECRET="agncypay-jwt-refresh-secret-change-in-production"
JWT_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"

# ─── Cybrid (Financial Infrastructure) ───────────────────────
CYBRID_CLIENT_ID=your-cybrid-client-id
CYBRID_CLIENT_SECRET=your-cybrid-client-secret
CYBRID_BANK_GUID=your-cybrid-bank-guid
CYBRID_BASE_URL=https://bank.sandbox.cybrid.app
CYBRID_IDP_URL=https://id.sandbox.cybrid.app
CYBRID_ENVIRONMENT=sandbox
CYBRID_WEBHOOK_SECRET=your-cybrid-webhook-secret

# ─── Plaid (Bank Verification) ───────────────────────────────
PLAID_CLIENT_ID=your-plaid-client-id
PLAID_SECRET=your-plaid-secret
PLAID_ENV=sandbox

# ─── QuickBooks ───────────────────────────────────────────────
QUICKBOOKS_CLIENT_ID=your-quickbooks-client-id
QUICKBOOKS_CLIENT_SECRET=your-quickbooks-client-secret
QUICKBOOKS_ENVIRONMENT=sandbox
QUICKBOOKS_REDIRECT_URI=http://localhost:3001/api/v1/integrations/quickbooks/callback

# ─── QBO Aliases ─────────────────────────────────────────────
QBO_CLIENT_ID=your-quickbooks-client-id
QBO_CLIENT_SECRET=your-quickbooks-client-secret
QBO_ENV=sandbox
QBO_REDIRECT_URI=http://localhost:3001/api/v1/integrations/quickbooks/callback

# ─── Xero ────────────────────────────────────────────────────
XERO_CLIENT_ID=your-xero-client-id
XERO_CLIENT_SECRET=your-xero-client-secret
XERO_REDIRECT_URI=http://localhost:3001/api/v1/integrations/xero/callback

# ─── Sage ────────────────────────────────────────────────────
SAGE_CLIENT_ID=
SAGE_CLIENT_SECRET=
SAGE_REDIRECT_URI=http://localhost:3001/api/v1/integrations/sage/callback

# ─── Frontend ────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
